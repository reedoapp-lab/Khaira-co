# Email delivery for website enquiries (optional in development).
# Without these values, enquiries are logged to the server console and the
# form still returns a success response. Add all three to enable email.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiry notifications should be sent
CONTACT_TO_EMAIL=hello@khaira-co.eu

# Verified sender address in Resend
CONTACT_FROM_EMAIL=Khaira.co <enquiries@khaira-co.eu>
